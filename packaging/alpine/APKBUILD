# Maintainer: q7xk <q7xk@users.noreply.github.com>
pkgname=rustfetch
pkgver=0.1.1
pkgrel=0
pkgdesc="A lightweight, fast, minimal system information tool for Linux"
url="https://github.com/q7xk/rustfetch"
arch="all"
license="MIT"
makedepends="cargo cargo-auditable"
source="$pkgname-$pkgver.tar.gz::https://github.com/q7xk/rustfetch/archive/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"
options="net"

prepare() {
	default_prepare
	cargo fetch --locked --target="$CTARGET"
}

build() {
	cargo auditable build --frozen --release
}

check() {
	cargo test --frozen --release
}

package() {
	install -Dm755 target/release/rustfetch "$pkgdir"/usr/bin/rustfetch
	install -Dm644 docs/rustfetch.1 "$pkgdir"/usr/share/man/man1/rustfetch.1
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
}

sha512sums="
SKIP  rustfetch-$pkgver.tar.gz
"
