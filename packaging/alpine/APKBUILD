# Maintainer: q7xk <q7xk@users.noreply.github.com>
pkgname=ultrafetch
pkgver=0.1.1
pkgrel=0
pkgdesc="A lightweight, fast, minimal system information tool for Linux"
url="https://github.com/q7xk/ultrafetch"
arch="all"
license="MIT"
makedepends="cargo cargo-auditable"
source="$pkgname-$pkgver.tar.gz::https://github.com/q7xk/ultrafetch/archive/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"
options="net"

prepare() {
	default_prepare
	cargo fetch --locked --target="$CTARGET"
}

build() {
	cargo auditable build --frozen --release
}

check() {
	cargo test --frozen --release
}

package() {
	install -Dm755 target/release/ultrafetch "$pkgdir"/usr/bin/ultrafetch
	install -Dm644 docs/ultrafetch.1 "$pkgdir"/usr/share/man/man1/ultrafetch.1
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
}

sha512sums="
SKIP  ultrafetch-$pkgver.tar.gz
"
